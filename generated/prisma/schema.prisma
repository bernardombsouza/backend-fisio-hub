generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("PHYSIO") // Removido o enum
  crefito   String?
  avatarUrl String?
  createdAt DateTime @default(now())

  @@map("users")
}
